; заголовок
43 4c 56 4d     ; CLVM
01 00           ; версия формата
00 00 00 00     ; количество ячеек ax
04 00 00 00     ; количество ячеек bx
00 00 00 00     ; количество ячеек cx
00              ; абсолютный адрес rdata
14 00           ; абсолютный адрес srdata
00 00           ; абсолютный адрес text

; секция srdata
19 43 61 6C 63 6C 75 6C 61 74 6F 72 20 6F 6E 20 43 61 6C 63 6C 61 6E 67 21 0A   ; Calculator on Calclang!, 45
0A 4E 75 6D 62 65 72 20 31 3A 20                                                ; Number 1:, 56
0A 4E 75 6D 62 65 72 20 32 3A 20                                                ; Number 2:, 67
08 52 65 73 75 6C 74 3A 20                                                      ; Result:, 76
01 0A                                                                           ; новая строка, 78

; секция text
01 14 00
01 2E 00
02 01 00 00 00 00                   ; 2 байт - номер массива - 00 - ax, 01 - bx, 02 - cx
01 39 00
02 01 01 00 00 00
03 01 00 00 00 00 01 02 00 00 00    ; dup - 0x03
03 01 01 00 00 00 01 03 00 00 00
